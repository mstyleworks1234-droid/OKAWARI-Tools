{
  "manifest_version": 3,
  "name": "QuickShot Page Capture",
  "version": "1.1.0",
  "description": "Captures the active Chrome or Edge page for QuickShot.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"}
}
